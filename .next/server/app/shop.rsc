1c:["$","$L24",null,{"initialProducts":[{"id":"prod-001","slug":"royal-crimson-banarasi-katan-silk-saree","name":"Royal Crimson Banarasi Katan Silk Saree","description":"Handcrafted pure Banarasi Katan silk saree woven in deep bridal crimson with intricate antique gold zari floral jaal and an ornate statement pallu. Includes an unstitched pure silk blouse piece with matching zari border.","shortDescription":"Pure Katan silk in deep bridal crimson with antique gold zari work.","category":"sarees","subcategory":"banarasi-sarees","price":14999,"compareAtPrice":18500,"currency":"INR","available":true,"sizes":["Free Size (5.5m + 0.8m Blouse)"],"colors":[{"name":"Crimson Maroon","hex":"#6B1F2A"},{"name":"Rani Pink","hex":"#A82B57"},{"name":"Emerald Green","hex":"#1E4D3B"}],"fabric":"Banarasi Katan Silk","weaveType":"Kadhwa Handloom","occasion":["Wedding","Festive","Celebration"],"badges":["BESTSELLER","FESTIVE"],"sku":"KS-BAN-001","includesBlousePiece":true,"sareeLengthMeters":5.5,"blouseLengthMeters":0.8,"careInstructions":["Dry clean only","Wrap in muslin cloth for storage","Low steam iron on reverse side"],"images":[{"id":"img-001-1","url":"https://images.unsplash.com/photo-1610030469983-98e550d6193c?auto=format&fit=crop&w=1000&q=80","alt":"Royal Crimson Banarasi Katan Silk Saree front drape","isPrimary":true,"viewType":"front"},{"id":"img-001-2","url":"https://images.unsplash.com/photo-1617627143750-d86bc21e42bb?auto=format&fit=crop&w=1000&q=80","alt":"Royal Crimson Banarasi Saree pallu close-up detail","isPrimary":false,"viewType":"pallu"}],"createdAt":"2026-09-01T00:00:00Z","updatedAt":"2026-10-01T00:00:00Z"},{"id":"prod-002","slug":"mustard-gold-chanderi-silk-festive-saree","name":"Mustard Gold Chanderi Silk Festive Saree","description":"Luminous mustard gold Chanderi silk saree accented with delicate silver-gold butis and a sheer gossamer texture. Lightweight and breathable for daytime pujas, haldi ceremonies, and festive gatherings.","shortDescription":"Lightweig