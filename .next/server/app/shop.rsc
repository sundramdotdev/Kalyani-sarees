ccasion":["Wedding","Festive","Party Wear"],"badges":["BESTSELLER"],"sku":"KS-LAD-005","careInstructions":["Dry clean only"],"images":[{"id":"img-005-1","url":"https://images.unsplash.com/photo-1609357605129-26f69add5d6e?auto=format&fit=crop&w=1000&q=80","alt":"Emerald Green Embroidered Anarkali Suit Set","isPrimary":true,"viewType":"front"}],"createdAt":"2026-09-15T00:00:00Z","updatedAt":"2026-10-01T00:00:00Z"},{"id":"prod-006","slug":"ivory-gold-chanderi-straight-kurti-set","name":"Ivory & Gold Chanderi Straight Kurti Set","description":"Graceful straight-fit ivory Chanderi kurti tailored with delicate zari thread work along the placket, matched with tapered trousers and a lightweight silk dupatta.","shortDescription":"Tailored straight kurti with zari embroidery and trousers.","category":"ladies-wear","subcategory":"kurtis","price":3899,"compareAtPrice":4800,"currency":"INR","available":true,"sizes":["S","M","L","XL"],"colors":[{"name":"Ivory Gold","hex":"#FDFBF7"},{"name":"Beige Honey","hex":"#E5D3B3"}],"fabric":"Chanderi Silk","occasion":["Daily Wear","Puja","Celebration"],"badges":["NEW"],"sku":"KS-KUR-006","careInstructions":["Hand wash cold with mild liquid or dry clean"],"images":[{"id":"img-006-1","url":"https://images.unsplash.com/photo-1583391733956-3750e0ff4e8b?auto=format&fit=crop&w=1000&q=80","alt":"Ivory & Gold Chanderi Straight Kurti Set","isPrimary":true,"viewType":"front"}],"createdAt":"2026-09-18T00:00:00Z","updatedAt":"2026-10-01T00:00:00Z"},{"id":"prod-007","slug":"deep-wine-velvet-embroidered-bridal-lehenga","name":"Deep Wine Velvet Hand-Embroidered Bridal Lehenga","description":"Heirloom bridal lehenga crafted from micro-velvet, embellished with zardozi, dabka, and antique sequin work. Complemented by an intricately embroidered blouse and dual dupattas.","shortDescription":"Micro-velvet bridal lehenga with zardozi and dabka craftsmanship.","category":"ladies-wear","subcategory":"lehengas","price":24999,"compareAtPrice":32000,"currency":"INR",