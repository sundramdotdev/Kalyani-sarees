0:{"buildId":"GGW27N2--P254nysdTJR2","data":[{"rsc":["$","$1","c",{"children":[["$","$L2",null,{"initialProducts":[{"id":"prod-001","slug":"royal-crimson-banarasi-katan-silk-saree","name":"Royal Crimson Banarasi Katan Silk Saree","description":"Handcrafted pure Banarasi Katan silk saree woven in deep bridal crimson with intricate antique gold zari floral jaal and an ornate statement pallu. Includes an unstitched pure silk blouse piece with matching zari border.","shortDescription":"Pure Katan silk in deep bridal crimson with antique gold zari work.","category":"sarees","subcategory":"banarasi-sarees","price":14999,"compareAtPrice":18500,"currency":"INR","available":true,"sizes":["Free Size (5.5m + 0.8m Blouse)"],"colors":[{"name":"Crimson Maroon","hex":"#6B1F2A"},{"name":"Rani Pink","hex":"#A82B57"},{"name":"Emerald Green","hex":"#1E4D3B"}],"fabric":"Banarasi Katan Silk","weaveType":"Kadhwa Handloom","occasion":["Wedding","Festive","Celebration"],"badges":["BESTSELLER","FESTIVE"],"sku":"KS-BAN-001","includesBlousePiece":true,"sareeLengthMeters":5.5,"blouseLengthMeters":0.8,"careInstructions":["Dry clean only","Wrap in muslin cloth for storage","Low steam iron on reverse side"],"images":[{"id":"img-001-1","url":"https://images.unsplash.com/photo-1610030469983-98e550d6193c?auto=format&fit=crop&w=1000&q=80","alt":"Royal Crimson Banarasi Katan Silk Saree front drape","isPrimary":true,"viewType":"front"},{"id":"img-001-2","url":"https://images.unsplash.com/photo-1617627143750-d86bc21e42bb?auto=format&fit=crop&w=1000&q=80","alt":"Royal Crimson Banarasi Saree pallu close-up detail","isPrimary":false,"viewType":"pallu"}],"createdAt":"2026-09-01T00:00:00Z","updatedAt":"2026-10-01T00:00:00Z"},{"id":"prod-002","slug":"mustard-gold-chanderi-silk-festive-saree","name":"Mustard Gold Chanderi Silk Festive Saree","description":"Luminous mustard gold Chanderi silk saree accented with delicate silver-gold butis and a sheer gossamer texture. Lightweight and breathable for daytime pujas, haldi ceremonies, and festive gatherings.","shortDescription":"Lightweight Chanderi silk with delicate zari butis.","category":"sarees","subcategory":"festive-sarees","price":6499,"compareAtPrice":7999,"currency":"INR","available":true,"sizes":["Free Size (5.5m + 0.8m Blouse)"],"colors":[{"name":"Mustard Gold","hex":"#D4AF37"},{"name":"Pastel Peach","hex":"#F4C2C2"}],"fabric":"Chanderi Silk","weaveType":"Handloom Silk-Cotton","occasion":["Festive","Puja","Celebration"],"badges":["NEW"],"sku":"KS-CHN-002","includesBlousePiece":true,"sareeLengthMeters":5.5,"blouseLengthMeters":0.8,"careInstructions":["Dry clean recommended","Store folded in cool, dry place"],"images":[{"id":"img-002-1","url":"https://images.unsplash.com/photo-1583391733956-3750e0ff4e8b?auto=format&fit=crop&w=1000&q=80","alt":"Mustard Gold Chanderi Silk Festive Saree drape","isPrimary":true,"viewType":"front"}],"createdAt":"2026-09-10T00:00:00Z","updatedAt":"2026-10-01T00:00:00Z"},{"id":"prod-003","slug":"pure-kanjivaram-zari-silk-saree","name":"Pure Kanjivaram Zari Temple Border Silk Saree","description":"Regal South Indian handloom Kanjivaram silk saree woven in rich ruby wine with a contrasting antique gold temple korvai border and solid zari pallu. An auspicious treasure for bridal trousseaus.","shortDescription":"Handloom Kanjivaram silk with temple zari border.","category":"sarees","subcategory":"silk-sarees","price":18999,"compareAtPrice":24000,"currency":"INR","available":true,"sizes":["Free Size (5.5m + 0.8m Blouse)"],"colors":[{"name":"Ruby Wine","hex":"#58111A"},{"name":"Deep Purple","hex":"#3B1845"}],"fabric":"Pure Kanjivaram Silk","weaveType":"Korvai Handloom","occasion":["Wedding","Celebration"],"badges":["LIMITED","BESTSELLER"],"sku":"KS-KAN-003","includesBlousePiece":true,"sareeLengthMeters":5.5,"blouseLengthMeters":0.8,"careInstructions":["Dry clean only","Keep wrapped in unbleached cotton"],"images":[{"id":"img-003-1","url":"https://images.unsplash.com/photo-1610030469983-98e550d6193c?auto=format&fit=crop&w=1000&q=80","alt":"Pure Kanjivaram Zari Temple Border Silk Saree","isPrimary":true,"viewType":"front"}],"createdAt":"2026-09-25T00:00:00Z","updatedAt":"2026-10-01T00:00:00Z"},{"id":"prod-004","slug":"pastel-blush-organza-floral-festive-saree","name":"Pastel Blush Hand-Painted Organza Saree","description":"Delicate sheer organza saree with hand-painted floral motifs and fine gota patti scalloped border. Fluid, ethereal, and contemporary for reception and engagement parties.","shortDescription":"Sheer organza with hand-painted floral accents and gota border.","category":"sarees","subcategory":"festive-sarees","price":5899,"compareAtPrice":7200,"currency":"INR","available":true,"sizes":["Free Size (5.5m + 0.8m Blouse)"],"colors":[{"name":"Blush Pink","hex":"#FFD1DC"},{"name":"Mint Green","hex":"#C1E1C1"}],"fabric":"Organza","weaveType":"Hand Embroidered","occasion":["Party Wear","Celebration","Festive"],"badges":["NEW"],"sku":"KS-ORG-004","includesBlousePiece":true,"sareeLengthMeters":5.5,"blouseLengthMeters":0.8,"careInstructions":["Dry clean only","Do not wring"],"images":[{"id":"img-004-1","url":"https://images.unsplash.com/photo-1617627143750-d86bc21e42bb?auto=format&fit=crop&w=1000&q=80","alt":"Pastel Blush Hand-Painted Organza Saree","isPrimary":true,"viewType":"front"}],"createdAt":"2026-09-28T00:00:00Z","updatedAt":"2026-10-01T00:00:00Z"},{"id":"prod-005","slug":"emerald-green-embroidered-anarkali-suit-set","name":"Emerald Green Embroidered Anarkali Suit Set","description":"Stately 3-piece emerald green anarkali ensemble featuring intricate thread and gota patti embroidery on the neckline, paired with churidar pants and a contrast Banarasi tissue dupatta.","shortDescription":"3-Piece embroidered anarkali with Banarasi tissue dupatta.","category":"ladies-wear","subcategory":"suit-sets","price":8999,"compareAtPrice":11500,"currency":"INR","available":true,"sizes":["S","M","L","XL","XXL"],"colors":[{"name":"Emerald Green","hex":"#1E4D3B"},{"name":"Deep Navy","hex":"#1B2A47"}],"fabric":"Georgette & Silk Blend","occasion":["Wedding","Festive","Party Wear"],"badges":["BESTSELLER"],"sku":"KS-LAD-005","careInstructions":["Dry clean only"],"images":[{"id":"img-005-1","url":"https://images.unsplash.com/photo-1609357605129-26f69add5d6e?auto=format&fit=crop&w=1000&q=80","alt":"Emerald Green Embroidered Anarkali Suit Set","isPrimary":true,"viewType":"front"}],"createdAt":"2026-09-15T00:00:00Z","updatedAt":"2026-10-01T00:00:00Z"},{"id":"prod-007","slug":"deep-wine-velvet-embroidered-bridal-lehenga","name":"Deep Wine Velvet Hand-Embroidered Bridal Lehenga","description":"Heirloom bridal lehenga crafted from micro-velvet, embellished with zardozi, dabka, and antique sequin work. Complemented by an intricately embroidered blouse and dual dupattas.","shortDescription":"Micro-velvet bridal lehenga with zardozi and dabka craftsmanship.","category":"ladies-wear","subcategory":"lehengas","price":24999,"compareAtPrice":32000,"currency":"INR","available":true,"sizes":["Semi-Stitched (Fits up to 42 Bust/Waist)"],"colors":[{"name":"Deep Wine","hex":"#4A1521"},{"name":"Bridal Crimson","hex":"#6B1F2A"}],"fabric":"Brocade","occasion":["Wedding","Celebration"],"badges":["LIMITED","FESTIVE"],"sku":"KS-LEH-007","careInstructions":["Strictly professional dry clean only"],"images":[{"id":"img-007-1","url":"https://images.unsplash.com/photo-1610030469983-98e550d6193c?auto=format&fit=crop&w=1000&q=80","alt":"Deep Wine Velvet Hand-Embroidered Bridal Lehenga","isPrimary":true,"viewType":"front"}],"createdAt":"2026-09-20T00:00:00Z","updatedAt":"2026-10-01T00:00:00Z"},{"id":"prod-008","slug":"boys-maroon-brocade-kurta-pyjama-jacket-set","name":"Boys Maroon Brocade Kurta Pyjama & Jacket Set","description":"Charming 3-piece traditional ensemble for young boys featuring a soft cotton-silk kurta, tailored churidar pyjama, and an antique gold brocade Nehru jacket with metallic buttons.","shortDescription":"3-Piece boys ethnic set with brocade Nehru jacket.","category":"kids-wear","subcategory":"boys","price":3499,"compareAtPrice":4299,"currency":"INR","available":true,"sizes":["2-3 Yrs","4-5 Yrs","6-7 Yrs","8-9 Yrs","10-12 Yrs"],"colors":[{"name":"Maroon & Gold","hex":"#6B1F2A"},{"name":"Royal Blue & Cream","hex":"#1A365D"}],"fabric":"Brocade","occasion":["Festive","Wedding","Celebration"],"badges":["FESTIVE"],"sku":"KS-KID-008","careInstructions":["Gentle dry clean or delicate hand wash with mild detergent"],"images":[{"id":"img-008-1","url":"https://images.unsplash.com/photo-1596461404969-9ae70f2830c1?auto=format&fit=crop&w=1000&q=80","alt":"Boys Maroon Brocade Kurta Pyjama Set","isPrimary":true,"viewType":"front"}],"createdAt":"2026-09-20T00:00:00Z","updatedAt":"2026-10-01T00:00:00Z"},{"id":"prod-009","slug":"girls-rani-pink-festive-lehenga-choli","name":"Girls Rani Pink Festive Silk Lehenga Choli","description":"Radiant Rani pink traditional lehenga choli set for young girls with pure cotton lining for maximum comfort during long wedding festivities. Highlighted by delicate gold border trims and a matching net dupatta.","shortDescription":"Comfort-lined festive lehenga choli with dupatta for girls.","category":"kids-wear","subcategory":"girls","price":3999,"compareAtPrice":4999,"currency":"INR","available":true,"sizes":["3-4 Yrs","5-6 Yrs","7-8 Yrs","9-10 Yrs","11-12 Yrs"],"colors":[{"name":"Rani Pink","hex":"#A82B57"},{"name":"Turquoise Blue","hex":"#008080"}],"fabric":"Cotton Handloom","occasion":["Festive","Wedding","Celebration"],"badges":["NEW"],"sku":"KS-KID-009","careInstructions":["Dry clean only"],"images":[{"id":"img-009-1","url":"https://images.unsplash.com/photo-1621644827827-2b7e19391cf8?auto=format&fit=crop&w=1000&q=80","alt":"Girls Rani Pink Festive Silk Lehenga Choli","isPrimary":true,"viewType":"front"}],"createdAt":"2026-09-22T00:00:00Z","updatedAt":"2026-10-01T00:00:00Z"},{"id":"prod-010","slug":"auspicious-sindoor-red-bridal-wedding-saree","name":"Auspicious Sindoor Red Bridal 