ious Sindoor Red Bridal Wedding Silk Saree","isPrimary":true,"viewType":"front"}],"createdAt":"2026-09-29T00:00:00Z","updatedAt":"2026-10-01T00:00:00Z"},{"id":"prod-011","slug":"royal-brocade-festive-ensemble","name":"Heritage Brocade Festive Kurta & Dupatta Ensemble","description":"A regal celebration ensemble featuring a gold-woven pure brocade tunic, silk pants, and an authentic heritage dupatta.","shortDescription":"Gold-woven brocade tunic and dupatta set.","category":"indian-attire","subcategory":"festive-wear","price":11499,"compareAtPrice":14000,"currency":"INR","available":true,"sizes":["S","M","L","XL"],"colors":[{"name":"Antique Gold","hex":"#B08D57"},{"name":"Deep Ochre","hex":"#CC7722"}],"fabric":"Brocade","occasion":["Festive","Wedding","Puja"],"badges":["FESTIVE"],"sku":"KS-ATT-011","careInstructions":["Dry clean only"],"images":[{"id":"img-011-1","url":"https://images.unsplash.com/photo-1583391733956-3750e0ff4e8b?auto=format&fit=crop&w=1000&q=80","alt":"Heritage Brocade Festive Kurta & Dupatta Ensemble","isPrimary":true,"viewType":"front"}],"createdAt":"2026-09-30T00:00:00Z","updatedAt":"2026-10-01T00:00:00Z"}],"categoryTitle":"The Complete Ethnic Catalog","categoryDescription":"Handcrafted Banarasi sarees, embroidered suit sets, and festive attire for every auspicious celebration."}]
